# ---------------------------------------------------------------------------
# United HRMS — frontend environment configuration
#
# Copy this file to `.env` (or `.env.local`) in this folder and adjust as
# needed: `cp .env.example .env`
#
# Vite only exposes variables prefixed `VITE_` to client code (anything else
# is silently unavailable via import.meta.env — this is a Vite security
# default, not a bug). Every variable below is read, validated, and typed in
# src/config/env.ts — that file is the ONLY place `import.meta.env` should
# ever be referenced; everywhere else should import `env` from there.
#
# `.env`/`.env.local` are gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Backend API ---
# Base URL of the Django backend's versioned API — see ../backend and
# HRMS_Architecture.md. Point this at whatever environment you're running
# against (local docker-compose, staging, ...).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- App metadata ---
VITE_APP_NAME=United HRMS
# One of: development | staging | production — purely descriptive (e.g. an
# environment badge in the UI later); does not change build behavior, which
# is controlled by Vite's own --mode flag and import.meta.env.DEV/PROD.
VITE_APP_ENV=development
