# Telegram Gateway environment — see src/config.py for validation and
# defaults. All variables are prefixed TELEGRAM_GATEWAY_ so they can never
# be confused with (or accidentally satisfy) the Django backend's own env
# vars when both containers share a docker-compose env pool.

TELEGRAM_GATEWAY_BOT_TOKEN=replace-with-a-real-botfather-token
TELEGRAM_GATEWAY_WEBHOOK_SECRET_TOKEN=replace-with-a-random-32-byte-secret
TELEGRAM_GATEWAY_WEBHOOK_PATH=/webhook/telegram

TELEGRAM_GATEWAY_HRMS_API_BASE_URL=http://backend:8000
TELEGRAM_GATEWAY_HRMS_API_TIMEOUT_SECONDS=10
# Sent as X-Internal-Service-Key on every backend call — see
# src/api_client/hrms_client.py. Must match the backend's own
# INTERNAL_SERVICE_API_KEY (backend/.env.example / root .env) EXACTLY —
# these are the same secret, documented in both places since each service
# reads it under its own variable name. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_GATEWAY_INTERNAL_API_KEY=replace-with-a-generated-secret

# This service's OWN Redis — never the backend's. See auth/account_linking.py.
# Hostname matches infra/docker-compose.yml's `telegram_gateway_redis`
# service name.
TELEGRAM_GATEWAY_REDIS_URL=redis://telegram_gateway_redis:6379/0

TELEGRAM_GATEWAY_ENVIRONMENT=development
TELEGRAM_GATEWAY_LOG_LEVEL=INFO
TELEGRAM_GATEWAY_RATE_LIMIT_PER_CHAT_PER_MINUTE=20
