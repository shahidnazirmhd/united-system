# ---------------------------------------------------------------------------
# United HRMS — environment configuration
#
# Copy this file to `.env` in the project root and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. In staging/production,
# these values are injected by the deployment platform's secret store
# (see HRMS_Architecture.md section 9), not read from a file on disk at all
# — this file exists to document what every required variable is and to
# support local development.
# ---------------------------------------------------------------------------

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-generate-with-python-c-import-secrets-print-secrets-token-urlsafe-50
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
APP_VERSION=0.1.0

# --- Database ---
# Hostnames below (`db`, `redis`) assume docker-compose networking, where
# each service is reachable by its compose service name. Running
# `manage.py` directly on the host machine instead of via docker-compose?
# Change `db`/`redis` to `localhost` in the URLs below.
DATABASE_URL=postgres://hrms_app:changeme@db:5432/united_hrms
DB_CONN_MAX_AGE=0
DB_SSL_MODE=prefer

# Consumed by the `db` container itself (infra/docker-compose.yml) — keep
# these in sync with the credentials embedded in DATABASE_URL above.
POSTGRES_DB=united_hrms
POSTGRES_USER=hrms_app
POSTGRES_PASSWORD=changeme

# --- Redis ---
# Three distinct roles today, plus one reserved for the Identity module
# (HRMS_Architecture.md section 8) — separate logical DB indexes now so any
# of them can be pointed at a fully separate Redis instance later with no
# code change, only a URL change.
REDIS_CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
REDIS_TOKEN_BLOCKLIST_URL=redis://redis:6379/3

# --- SMTP (shared email delivery — password reset, employee Telegram OTP) ---
# Leave SMTP_HOST empty to use the log-only fallback (LoggingEmailClient):
# emails are written to the backend's console/log output instead of being
# sent, so local development works with zero external setup. Set SMTP_HOST
# (and the rest of this block) to actually deliver real emails.
#
# --- Configuring a temporary Gmail account for development/testing ---
# 1. Create a new, disposable Gmail account (do not use a personal one —
#    app passwords grant full SMTP send access to that mailbox).
# 2. Turn on 2-Step Verification: myaccount.google.com/security.
#    App passwords require 2-Step Verification to be enabled first.
# 3. Generate an app password: myaccount.google.com/apppasswords.
#    Choose "Mail" as the app; Google generates a 16-character password.
#    Regular Gmail account passwords do NOT work over SMTP — only an app
#    password does.
# 4. Fill in the values below:
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=587
#      SMTP_USERNAME=your-temp-account@gmail.com
#      SMTP_PASSWORD=<the 16-character app password, no spaces>
#      SMTP_USE_TLS=True
#      SMTP_FROM_EMAIL=your-temp-account@gmail.com
# 5. Never commit the real .env file — SMTP_PASSWORD is a live credential.
#    Rotate/delete the app password (or the whole disposable account) once
#    testing is done.
#
# --- SMTP_FROM_EMAIL MUST equal SMTP_USERNAME when using Gmail ---
# This is the #1 cause of OTP emails landing in Spam (or being rejected
# outright). Gmail signs outgoing mail as the authenticated account
# (SMTP_USERNAME) — if SMTP_FROM_EMAIL claims to be a different address or
# a made-up domain (the no-reply@united-hrms.local default below doesn't
# exist as a real domain — it has no MX/SPF/DKIM/DMARC records at all),
# that mismatch is indistinguishable from header spoofing to a spam
# filter, regardless of how clean the email's content is. The backend logs
# a warning at startup if it detects this mismatch with a Gmail host — if
# you see it, fix SMTP_FROM_EMAIL, don't ignore it.
#
# --- Limitations of Gmail SMTP for this purpose, even configured correctly ---
# - Gmail enforces sending caps (roughly 500/day on a free consumer
#   account) and will throttle or temporarily block an account that sends
#   many similar automated messages in a short window — expect this if
#   you're stress-testing OTP requests.
# - A brand-new disposable account has no sending reputation yet, so early
#   deliverability can be worse before it gets better — reputation builds
#   up over time and with normal-looking usage, neither of which a fresh
#   throwaway test account has.
# - None of this is fixable by this codebase alone: real inbox-grade
#   deliverability needs a domain you control with SPF, DKIM, and DMARC
#   DNS records published, which is exactly what a transactional email
#   provider (Amazon SES, SendGrid, Mailgun, Postmark, etc.) sets up for
#   you. SmtpEmailClient works unchanged against any of them — it's a
#   config change (SMTP_HOST/PORT/USERNAME/PASSWORD), not a code change.
#   Treat Gmail here as strictly a development/testing convenience, never
#   a production email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=no-reply@united-hrms.local
# Display name only ("United HRMS" <SMTP_FROM_EMAIL>) — a bare address with
# no display name is another small, free spam signal; this fixes that part
# regardless of which SMTP provider is configured above.
SMTP_FROM_NAME=United HRMS
SMTP_TIMEOUT_SECONDS=10

# --- Internal service authentication (Telegram Gateway -> backend) ---
# Presented by the Telegram Gateway as the X-Internal-Service-Key header on
# every call to a Gateway-facing backend endpoint (employee lookup, OTP
# request/verify) — these endpoints authenticate employees who have no JWT
# of their own, so this shared secret is what proves the caller really is
# the Gateway and not an impostor. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match TELEGRAM_GATEWAY_INTERNAL_API_KEY in telegram_gateway/.env.example
# exactly — the two are the same secret, documented in both places since
# each service reads it under its own variable name.
INTERNAL_SERVICE_API_KEY=replace-with-a-generated-secret

# --- Approval Engine: backend -> Telegram Gateway (Phase 9) ---
# The reverse direction of the block above: apps.approvals's Celery task
# calls the Gateway's own POST /internal/notify to push an unsolicited
# Telegram message (a new approval request, or a decision) — authenticated
# with the SAME INTERNAL_SERVICE_API_KEY secret above, just presented in the
# opposite direction. http://telegram_gateway:8080 is the compose-network
# hostname (see infra/docker-compose.yml's `telegram_gateway` service) —
# don't change this to localhost, it won't resolve from inside the backend's
# own container.
TELEGRAM_GATEWAY_BASE_URL=http://telegram_gateway:8080
TELEGRAM_GATEWAY_NOTIFY_TIMEOUT_SECONDS=10

# --- JWT (Identity module) ---
# JWT_SIGNING_KEY is intentionally left commented out here, not set to an
# empty value — django-environ treats a present-but-empty variable as "set
# to empty string," not "unset," so it would NOT fall back to
# DJANGO_SECRET_KEY the way an absent variable does. Uncomment and set a
# real value in staging/production so the two secrets can be rotated
# independently; local dev signs with DJANGO_SECRET_KEY by default.
# JWT_SIGNING_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Celery ---
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# --- CORS ---
# Comma-separated list of allowed frontend origins. Empty by default —
# local dev uses CORS_ALLOW_ALL_ORIGINS instead (see
# backend/config/settings/local.py); this variable matters starting in
# staging/production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO
# "verbose" (human-readable, local dev) or "json" (structured, staging/prod)
LOG_FORMAT=verbose

# ---------------------------------------------------------------------------
# Telegram Gateway — infra/docker-compose.yml's `telegram_gateway` service
# reads this same root .env via `env_file: ../.env`, exactly like `backend`
# does. See telegram_gateway/.env.example and telegram_gateway/src/config.py
# for the full description of each variable; duplicated here (not just
# referenced) because docker-compose's `env_file` only reads one file per
# service, and this is the one both services share.
#
# Employee & Telegram Authentication refactor: TELEGRAM_GATEWAY_
# TOKEN_ENCRYPTION_KEY is gone — the Gateway no longer holds any
# per-employee credential to encrypt at rest (auth/token_store.py was
# deleted). TELEGRAM_GATEWAY_INTERNAL_API_KEY replaces it: the one secret
# the Gateway now needs, shared with the backend's own
# INTERNAL_SERVICE_API_KEY above (same value, two variable names).
# ---------------------------------------------------------------------------
TELEGRAM_GATEWAY_BOT_TOKEN=replace-with-a-real-botfather-token
TELEGRAM_GATEWAY_WEBHOOK_SECRET_TOKEN=replace-with-a-random-32-byte-secret
TELEGRAM_GATEWAY_WEBHOOK_PATH=/webhook/telegram
TELEGRAM_GATEWAY_HRMS_API_BASE_URL=http://backend:8000
TELEGRAM_GATEWAY_HRMS_API_TIMEOUT_SECONDS=10
# Must match INTERNAL_SERVICE_API_KEY above EXACTLY — same secret.
TELEGRAM_GATEWAY_INTERNAL_API_KEY=replace-with-a-generated-secret
# Hostname matches infra/docker-compose.yml's `telegram_gateway_redis`
# service name — a distinct Redis instance from `redis` above, on purpose.
TELEGRAM_GATEWAY_REDIS_URL=redis://telegram_gateway_redis:6379/0
TELEGRAM_GATEWAY_ENVIRONMENT=development
TELEGRAM_GATEWAY_LOG_LEVEL=INFO
TELEGRAM_GATEWAY_RATE_LIMIT_PER_CHAT_PER_MINUTE=20
